---
import { getLocale, getDict, equivalentPath, homePath } from '../i18n/utils';

interface Props {
  /** Explicit EN/ES pair from the page (posts); route map otherwise. */
  alternates?: { en: string; es: string };
}

const locale = getLocale(Astro.url);
const d = getDict(locale);
const currentPath = Astro.url.pathname;
const enPath = Astro.props.alternates?.en ?? equivalentPath(currentPath, 'en');
const esPath = Astro.props.alternates?.es ?? equivalentPath(currentPath, 'es');
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href={homePath(locale)} aria-label="Aníbal Rojas — home"><b>~</b>/anibal-rojas</a>
    <div class="header-right">
      <nav class="seg" aria-label={d.a11y.language}>
        <a
          class:list={['seg-item', { active: locale === 'en' }]}
          href={enPath}
          aria-current={locale === 'en' ? 'true' : undefined}
          hreflang="en"
        >EN</a>
        <a
          class:list={['seg-item', { active: locale === 'es' }]}
          href={esPath}
          aria-current={locale === 'es' ? 'true' : undefined}
          hreflang="es"
        >ES</a>
      </nav>
      <a class="btn header-cta" href={d.cta.bookHref}>{d.cta.book}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: var(--space-2) var(--space-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .wordmark {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: 0.01em;
  }
  .wordmark b { color: var(--amber); }
  .header-right {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .header-cta { display: none; }
  @media (min-width: 700px) { .header-cta { display: inline-block; } }
</style>
