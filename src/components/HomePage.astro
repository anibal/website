---
/**
 * Homepage template — shared by both locales.
 * Copy verbatim from reference/homepage-copy-anibal-rojas.md (v2, approved).
 * Section conventions from reference/homepage-mockup.html.
 * Testimonials section intentionally absent (handoff §6.1: <3 real quotes →
 * render nothing). The Bottleneck signature element lands in session 3.
 */
import Base from '../layouts/Base.astro';
import { getDict, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = getDict(locale);
---

<Base>
  <section class="hero">
    <div class="inner">
      <span class="eyebrow">{d.hero.eyebrow}</span>
      <h1>
        <span set:html={d.hero.title} /><span class="cursor" aria-hidden="true"></span>
      </h1>
      <p>{d.hero.lede}</p>
      <div class="actions">
        {/* TODO(calendly): swap mailto for the Calendly URL once decided */}
        <a class="btn" href={d.cta.bookHref}>{d.cta.book}</a>
        <a class="btn ghost" href="#services">{d.hero.secondary}</a>
      </div>
    </div>
  </section>

  <section class="thesis" id="thesis">
    <div class="inner">
      <div class="block">
        <h2>{d.thesis.title}</h2>
        <p>{d.thesis.p1}</p>
        <p set:html={d.thesis.p2} />
        {/* TODO(session-3): The Bottleneck signature element mounts here (static SVG fallback first). */}
      </div>
    </div>
  </section>

  <section class="who">
    <div class="inner">
      <div data-reveal>
        <span class="eyebrow">{d.who.eyebrow}</span>
        {/* Portrait pending (reserved decision) — fixed dims so the real photo drops in with zero layout change */}
        <div class="portrait" role="img" aria-label={d.who.portraitLabel}>{d.who.portraitLabel}</div>
      </div>
      <div class="who-text" data-reveal>
        {d.who.paragraphs.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </section>

  <section class="proof">
    <div class="inner">
      <span class="eyebrow">{d.proof.eyebrow}</span>
      <div class="proof-grid">
        {d.proof.cards.map((card) => (
          <div class="card" data-reveal>
            <h3>{card.title}</h3>
            <p set:html={card.text} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="services" id="services">
    <div class="inner">
      <span class="eyebrow">{d.services.eyebrow}</span>
      {d.services.items.map((item) => (
        <div class="service" data-reveal>
          <div class="num">{item.num}</div>
          {/* TODO(session-4): title links to the service page once those exist */}
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
      <div class="after" data-reveal>
        {/* TODO(calendly): swap mailto for the Calendly URL once decided */}
        <a class="btn ghost" href={d.cta.bookHref}>{d.services.after}</a>
      </div>
    </div>
  </section>

  <section class="ideas">
    <div class="inner">
      <span class="eyebrow">{d.ideas.eyebrow}</span>
      <p class="ideas-intro">{d.ideas.intro}</p>
      <div class="ideas-grid">
        <div class="card" data-reveal>
          <span class="tag">{d.ideas.writing.tag}</span>
          {/* TODO(session-4): link to /principles/ once the series landing exists */}
          <h3>{d.ideas.writing.title}</h3>
        </div>
        <div class="card" data-reveal>
          <span class="tag">{d.ideas.podcast.tag}</span>
          <h3>
            <a href={d.ideas.podcast.href} target="_blank" rel="noopener">{d.ideas.podcast.title}</a>
          </h3>
        </div>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  /* Scroll reveals — the homepage's only JS. Progressive enhancement: the
     hidden state (.reveal) is applied here, never by default CSS, so content
     is fully visible without JS or with reduced motion. */
  (() => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!('IntersectionObserver' in window)) return;
    const els = document.querySelectorAll('[data-reveal]');
    if (!els.length) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target;
          const sibs = el.parentElement
            ? Array.from(el.parentElement.querySelectorAll(':scope > [data-reveal]'))
            : [el];
          const i = Math.max(0, sibs.indexOf(el));
          el.style.transitionDelay = i * 60 + 'ms';
          el.classList.add('is-in');
          io.unobserve(el);
        }
      },
      { rootMargin: '0px 0px -10% 0px' }
    );
    els.forEach((el) => {
      el.classList.add('reveal');
      io.observe(el);
    });
  })();
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    padding: var(--space-7) var(--space-3) var(--space-6);
  }
  .hero h1 {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 640;
    font-size: var(--text-hero);
    line-height: var(--leading-display);
    letter-spacing: -0.015em;
    max-width: 21ch;
    text-wrap: balance;
  }
  .hero h1 em {
    font-style: italic;
    font-weight: 560;
    color: var(--amber);
  }
  .hero p {
    max-width: var(--prose);
    margin-top: var(--space-4);
    font-size: var(--text-lede);
  }
  .hero .actions {
    margin-top: var(--space-4);
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  /* ---------- orchestrated load sequence (handoff §3.4): eyebrow → headline
     → cursor blinks → lede → actions. Total 720ms ≤ 900ms budget; delays and
     durations only from the {120, 240, 480, 900} vocabulary.
     The h1 is the LCP element: it RISES only — an opacity fade would hold its
     first paint hostage to the animation end (measured: LCP = FCP + delay +
     duration). Motion must never gate the LCP paint. ---------- */
  @keyframes seq-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes seq-rise {
    from { transform: translateY(12px); }
    to { transform: none; }
  }
  .hero .eyebrow { animation: seq-fade var(--dur-2) var(--ease) backwards; }
  .hero h1 { animation: seq-rise var(--dur-3) var(--ease) var(--dur-1) backwards; }
  .hero .cursor { animation-delay: calc(var(--dur-3) + var(--dur-1)); }
  .hero p { animation: seq-fade var(--dur-2) var(--ease) var(--dur-3) backwards; }
  .hero .actions { animation: seq-fade var(--dur-2) var(--ease) var(--dur-3) backwards; }

  /* ---------- thesis ---------- */
  .thesis {
    padding: 0 var(--space-3) var(--space-6);
  }
  .thesis .block {
    border-left: 3px solid var(--amber);
    background: var(--card);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    box-shadow: 0 1px 2px rgba(25, 28, 33, 0.05);
  }
  .thesis h2 {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 560;
    font-style: italic;
    font-size: var(--text-h2);
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-2);
    text-wrap: balance;
  }
  .thesis p { max-width: var(--prose); }
  .thesis p + p { margin-top: var(--space-2); }
  .thesis strong { color: var(--slate); }

  /* ---------- who ---------- */
  .who {
    padding: 0 var(--space-3) var(--space-6);
  }
  .who .inner {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 900px) {
    .who .inner { grid-template-columns: 200px 1fr; }
  }
  .portrait {
    width: 160px;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    background: linear-gradient(140deg, var(--slate), color-mix(in srgb, var(--slate), var(--paper) 30%));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: center;
    padding: var(--space-2);
  }
  .who-text p { max-width: var(--prose); }
  .who-text p + p { margin-top: var(--space-2); }
  .who-text strong { font-weight: 600; }

  /* ---------- proof ---------- */
  .proof {
    padding: 0 var(--space-3) var(--space-6);
  }
  .proof-grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .proof-grid { grid-template-columns: 1fr 1fr; }
  }
  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }
  .card h3 {
    font-family: var(--font-mono);
    font-size: var(--text--1);
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--slate);
    margin-bottom: var(--space-2);
    text-transform: lowercase;
  }
  .card h3::before {
    content: "■ ";
    color: var(--amber);
    font-size: 0.7em;
    vertical-align: 0.15em;
  }
  .card p { font-size: 0.97rem; }

  /* ---------- services ---------- */
  .services {
    padding: 0 var(--space-3) var(--space-6);
  }
  .service {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--line);
  }
  .service:last-of-type { border-bottom: 1px solid var(--line); }
  @media (min-width: 840px) {
    .service { grid-template-columns: 64px 260px 1fr; gap: var(--space-3); }
  }
  .service .num {
    font-family: var(--font-mono);
    color: var(--amber);
    font-size: 0.95rem;
    padding-top: 4px;
  }
  .service h3 {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 560;
    font-size: var(--text-1);
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .service p {
    font-size: 0.99rem;
    max-width: 58ch;
  }
  .services .after { margin-top: var(--space-4); }

  /* ---------- ideas ---------- */
  .ideas {
    padding: 0 var(--space-3) var(--space-6);
  }
  .ideas-intro {
    max-width: var(--prose);
    margin-bottom: var(--space-3);
  }
  .ideas-grid {
    display: grid;
    gap: var(--space-2);
  }
  @media (min-width: 840px) {
    .ideas-grid { grid-template-columns: 1fr 1fr; }
  }
  .ideas .card h3 {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 560;
    font-size: var(--text-1);
    line-height: 1.3;
    color: var(--ink);
    letter-spacing: 0;
    text-transform: none;
    text-wrap: balance;
  }
  .ideas .card h3::before { content: none; }
  .ideas .card h3 a {
    color: inherit;
    text-decoration: none;
  }
  .ideas .card .tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--amber);
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: var(--space-2);
    text-transform: uppercase;
  }
</style>
