---
/**
 * The Bottleneck — the signature element (handoff §5). The thesis, demonstrated
 * instead of stated: work items flow through a delivery pipeline; "AI velocity"
 * multiplies only the code stage; the constraint migrates right, into the human
 * stages. SSR renders the deterministic static "now" snapshot (no-JS fallback,
 * reduced-motion base, OG-image basis); the client warms the same sim to the
 * same state, so hydration is invisible.
 */
import { getDict, type Locale } from '../../i18n/utils';
import { snapshot, VIEW, STAGES, PRESETS, queuePos } from './sim';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = getDict(locale);
const snap = snapshot('now', 25, 7);

// hot = constrained stage labels per preset (drives the amber stage labels)
const hot: Record<string, number[]> = { '2019': [1], '2024': [2], now: [2, 3] };
const i18n = { captions: d.bottleneck.captions, hot };

// rework arc: review (stage 2) sweeps back to code (stage 1)
const [rx, cx] = [VIEW.xs[2], VIEW.xs[1]];
const reworkPath = `M ${rx} ${VIEW.y} C ${rx} ${VIEW.reworkY + 20}, ${cx} ${VIEW.reworkY + 20}, ${cx} ${VIEW.y}`;
---

<figure class="bottleneck" data-bottleneck data-i18n={JSON.stringify(i18n)}>
  <div class="canvas">
    <svg
      viewBox={`0 0 ${VIEW.w} ${VIEW.h}`}
      role="img"
      aria-label={d.bottleneck.ariaLabel}
      preserveAspectRatio="xMidYMid meet"
    >
      {/* main flow line */}
      <line x1="0" y1={VIEW.y} x2={VIEW.w} y2={VIEW.y} class="flow" vector-effect="non-scaling-stroke" />
      {/* rework return arc — the client lights it while a token rides it */}
      <path d={reworkPath} class="rework-arc" data-rework-arc vector-effect="non-scaling-stroke" />
      {/* stage glyphs */}
      {VIEW.xs.map((x) => (
        <rect x={x - 7} y={VIEW.y - 7} width="14" height="14" class="node" vector-effect="non-scaling-stroke" />
      ))}
      {/* tokens — static SSR snapshot; the client re-renders this layer live */}
      <g data-tokens>
        {snap.tokens.map((t) => (
          <rect x={t.x - 2.5} y={t.y - 2.5} width="5" height="5" class="token" />
        ))}
      </g>
      {/* "+n" overflow counters, one per stage, hidden unless its queue exceeds the cap */}
      {STAGES.map((_, i) => (
        <text
          data-queue-count={i}
          class="queue-count"
          x={VIEW.xs[i] + VIEW.queueX}
          y={VIEW.y - 22 - (VIEW.queueCap - 1) * VIEW.queueGap}
          text-anchor="middle"
          style={snap.queues[i] > VIEW.queueCap ? undefined : 'display:none'}
        >
          +{Math.max(0, snap.queues[i] - VIEW.queueCap)}
        </text>
      ))}
    </svg>
    <ol class="labels" aria-hidden="true">
      {d.bottleneck.stages.map((label, i) => (
        <li class:list={[{ hot: hot.now.includes(i) }]} data-stage-label={i} style={`left:${(VIEW.xs[i] / VIEW.w) * 100}%`}>
          {label}
        </li>
      ))}
    </ol>
  </div>

  <div class="controls">
    <span class="control-label">{d.bottleneck.control}</span>
    <div class="seg" role="group" aria-label={d.bottleneck.controlAria}>
      {PRESETS.map((p) => (
        <button type="button" class:list={['seg-item', { active: p === 'now' }]} data-preset={p} aria-pressed={p === 'now' ? 'true' : 'false'}>
          {p}
        </button>
      ))}
    </div>
  </div>

  <figcaption class="caption">
    <span class="prompt" aria-hidden="true">&gt; </span><span data-caption aria-live="polite">{d.bottleneck.captions.now}</span>
  </figcaption>
</figure>

<script>
  import { mount } from './client';
  mount();
</script>

<style>
  .bottleneck {
    margin-top: var(--space-6);
  }
  .canvas {
    position: relative;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .flow {
    stroke: var(--ink);
    stroke-width: 1.5;
    opacity: 0.35;
  }
  .rework-arc {
    fill: none;
    stroke: var(--line);
    stroke-width: 1.5;
    stroke-dasharray: 3 4;
    opacity: 0.6;
    transition: opacity var(--dur-2) var(--ease), stroke var(--dur-2) var(--ease);
  }
  .rework-arc.live {
    stroke: var(--amber);
    opacity: 1;
  }
  .node {
    fill: var(--paper);
    stroke: var(--slate);
    stroke-width: 1.5;
  }
  /* global: the client creates token rects at runtime — they carry no scope id */
  :global(.token) {
    fill: var(--amber);
  }
  .queue-count {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--amber);
  }
  .labels {
    list-style: none;
    display: block;
    position: relative;
    height: 1.4em;
    margin-top: var(--space-1);
  }
  .labels li {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--slate);
    white-space: nowrap;
    transition: color var(--dur-2) var(--ease);
  }
  .labels li.hot {
    color: var(--amber);
  }
  .controls {
    margin-top: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .control-label {
    font-family: var(--font-mono);
    font-size: var(--text--1);
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .caption {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text--1);
    color: var(--ink);
    letter-spacing: 0.03em;
  }
  .caption .prompt {
    color: var(--muted);
  }
  /* narrow viewports: five 20%-spaced labels collide — stagger them onto two
     rows (axis-chart style) instead of shrinking past legibility */
  @media (max-width: 560px) {
    .labels { height: 2.7em; }
    .labels li { font-size: 0.62rem; }
    .labels li:nth-child(even) { top: 1.35em; }
  }
</style>
