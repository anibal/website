---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocale, getDict, equivalentPath, homePath, absoluteUrl } from '../i18n/utils';
import '../styles/fonts.css';
import '../styles/font-overrides.css';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  /** Page-specific title; defaults to the site meta title. */
  title?: string;
  /** Page-specific description; defaults to the site meta description. */
  description?: string;
}

const locale = getLocale(Astro.url);
const d = getDict(locale);
const title = Astro.props.title ?? d.meta.title;
const description = Astro.props.description ?? d.meta.description;

const site = Astro.site!;
const canonical = absoluteUrl(site, Astro.url.pathname);
const enUrl = absoluteUrl(site, equivalentPath(Astro.url.pathname, 'en'));
const esUrl = absoluteUrl(site, equivalentPath(Astro.url.pathname, 'es'));

// JSON-LD: Person, sitewide (handoff §8)
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Aníbal Rojas',
  url: absoluteUrl(site, homePath(locale)),
  jobTitle: 'Engineering Leadership Advisor',
  address: { '@type': 'PostalAddress', addressLocality: 'Medellín', addressCountry: 'CO' },
  sameAs: [
    'https://www.linkedin.com/in/anibalrojas/',
    'https://anibal.substack.com/',
    'https://ocorres.com',
    'https://i.usedtocode.com',
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F7F3" />

    {/* fonts: preloaded so they beat font-display: optional's ~100ms window on
        real connections; metric-matched fallbacks (font-overrides.css) keep any
        miss layout-invisible (CLS = 0). See brain: font-loading-strategy. */}
    <link rel="preload" href="/fonts/fraunces-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* canonical + hreflang pair (handoff §4) */}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    {/* TODO(og): generated OG images land in session 5 (satori); og:image intentionally omitted until then */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aníbal Rojas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'es' ? 'es_CO' : 'en_US'} />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{d.a11y.skip}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
